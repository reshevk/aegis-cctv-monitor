# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is gitignored — never commit real credentials.
#
# On Streamlit Community Cloud, don't upload secrets.toml at all —
# instead paste these into: App settings → Secrets

TELEGRAM_BOT_TOKEN = "your-telegram-bot-token-here"
TELEGRAM_CHAT_ID = "your-telegram-chat-id-here"
